    value: 10.5281/zenodo.23715001
    description: "DOI de conceito (todas as versões) no Zenodo"
  - type: doi
    value: 10.5281/zenodo.23715002
    description: "DOI da v0.2.0 no Zenodo"
repository-code: "https://github.com/cgarciafilho/anotador-sinan"
